{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "surya_api.py",
            "type": "debugpy",
            "request": "launch",
            "program": "surya_api.py",
            "console": "integratedTerminal",
            "env": {
                "PATH": "/opt/llama-cpp/bin:/home/al/local/AI-tools/surya_api/.venv/bin:/usr/local/cuda-13.1/bin:$PATH",
                // "LLAMA_CPP_BINARY": "/opt/llama-cpp/bin/llama-server",
                "LD_LIBRARY_PATH": "/opt/llama-cpp/lib:/usr/local/cuda-13.1/lib64:$LD_LIBRARY_PATH",
                "SURYA_INFERENCE_BACKEND": "llamacpp",
                // "SURYA_INFERENCE_BACKEND": "vllm",
                "SURYA_INFERENCE_CTX_SIZE": "262144",
                // "SURYA_INFERENCE_PARALLEL": "3",
                "SURYA_INFERENCE_MAX_WORKERS": "3",
                // "SURYA_GUIDED_TABLE_REC": "true",
                // "SURYA_MAX_TOKENS_FULL_PAGE": "262144",
                // "SURYA_INFERENCE_CTX_PER_SLOT": "262144",
                "LLAMA_CPP_NGL": "999",
                // "OLLAMA_URL": "http://localhost:11434"
                "OLLAMA_URL_LAYOUT": "http://localhost:11434",
                // "DEBUG_FOLDER": "/home/al/prj/ITSumma/NPZ"
                "DEBUG_FOLDER": "/home/al/prj/ITSumma/NPZ/Пример2/"
            },
        },
        {
            "name": "surya-gui",
            "type": "debugpy",
            "request": "launch",
            "program": "surya-gui",
            "console": "integratedTerminal",
            "env": {
                "PATH": "/opt/llama-cpp/bin:/home/al/local/AI-tools/surya_api/.venv/bin:$PATH",
                "LD_LIBRARY_PATH": "/opt/llama-cpp/lib:/usr/local/lib:$LD_LIBRARY_PATH",
                "SURYA_INFERENCE_BACKEND": "llamacpp",
                "SURYA_INFERENCE_CTX_SIZE": "100000",
                "SURYA_INFERENCE_PARALLEL": "2",
                "SURYA_INFERENCE_CTX_PER_SLOT": "50000",
                "LLAMA_CPP_NGL": "-1",
            },
            "args": ["--remote-debug", "--port", "8521"]
        }
    ]
}